{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fluxo-de-caixa",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fluxo-de-caixa",
      "database_id": "487d7296-0a16-43c5-ba45-41a2f8a60521"
    }
  ],
  "observability": { "enabled": true }
}
